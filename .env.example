# Local Node/Vite development. Docker Compose injects PGHOST/PGUSER/etc instead.
DATABASE_URL=postgresql://freewill:freewill-local-change-me@127.0.0.1:55432/freewill
# Keep false when Vite and Docker share Postgres; the Docker runner owns recovery.
FREEWILL_DEV_RECOVER_INTERRUPTED=false

# Docker Compose defaults. Change the password before exposing PostgreSQL remotely.
POSTGRES_DB=freewill
POSTGRES_USER=freewill
POSTGRES_PASSWORD=freewill-local-change-me
APP_PORT=5173
POSTGRES_PORT=55432
DASHBOARD_PORT=8080
PUBLIC_APP_URL=http://localhost:5173
DATABASE_DASHBOARD_URL=http://localhost:8080
# Local evolving-brain service (loopback only outside Docker)
FREEWILL_BRAIN_TOKEN=freewill-local-brain
BRAIN_PORT=8008
FREEWILL_BRAIN_THREADS=2

